<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_toggle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_toggle_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_widget_play"
        android:contentDescription="@string/widget_toggle_label" />

    <TextView
        android:id="@+id/widget_toggle_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_start"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
