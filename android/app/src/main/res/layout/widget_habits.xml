<?xml version="1.0" encoding="utf-8"?>
<!-- Habit check-square widget: up to 5 slots, shown/hidden by width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habits_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_habits_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/widget_habits_empty"
        android:textColor="@color/widget_text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_habit_slot_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_habit_icon_1"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_habit_name_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/widget_habit_square_1"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/widget_habit_square"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_habit_slot_2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_habit_icon_2"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_habit_name_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/widget_habit_square_2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/widget_habit_square"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_habit_slot_3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_habit_icon_3"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_habit_name_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/widget_habit_square_3"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/widget_habit_square"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_habit_slot_4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_habit_icon_4"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_habit_name_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/widget_habit_square_4"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/widget_habit_square"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_habit_slot_5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_habit_icon_5"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/widget_habit_name_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/widget_habit_square_5"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/widget_habit_square"
            android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
