<?xml version="1.0" encoding="utf-8"?>
<!-- Nag widget: 2×1 minimum, grows horizontally. updatePeriodMillis = 30 min so
     an overdue nag flips from a count-down to "was due" without an alarm. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="50dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:minResizeWidth="140dp"
    android:minResizeHeight="50dp"
    android:widgetCategory="home_screen"
    android:description="@string/widget_nag_description"
    android:previewLayout="@layout/widget_nag"
    android:initialLayout="@layout/widget_nag"
    android:updatePeriodMillis="1800000" />
