<?xml version="1.0" encoding="utf-8"?>
<!-- Food widget: a list, so it wants height. 3×2 by default, resizable both ways. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="140dp"
    android:minResizeHeight="90dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_food_description"
    android:previewLayout="@layout/widget_food"
    android:initialLayout="@layout/widget_food"
    android:updatePeriodMillis="0" />
