{
  "name": "kelomit-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Kelomit desktop companion \u2014 a live mirror of the phone with editing over the LAN",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "package": "electron-vite build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^13.0.2",
    "date-fns": "^4.1.0",
    "hono": "^4.6.14",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "electron-builder": "^26.0.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "build": {
    "appId": "fi.pico.kelomit.companion",
    "productName": "Kelomit Companion",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "target": "dir",
      "identity": null,
      "category": "public.app-category.productivity"
    },
    "npmRebuild": false
  }
}
